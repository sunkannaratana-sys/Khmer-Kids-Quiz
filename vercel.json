{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|pwa-|icon\\.svg|apple-touch-icon\\.png|manifest\\.webmanifest|sw\\.js|workbox-).*)",
      "destination": "/index.html"
    }
  ]
}
